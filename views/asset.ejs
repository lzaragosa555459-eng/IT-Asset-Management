<h1>Assets</h1>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Asset Tag</th>
            <th>Name</th>
            <th>Category</th>
            <th>Brand</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        <% assets.forEach(asset => { %>
            <tr>
                <td><%= asset.id %></td>
                <td><%= asset.asset_tag %></td>
                <td><%= asset.name %></td>
                <td><%= asset.category %></td>
                <td><%= asset.brand %></td>
                <td><%= asset.status %></td>
            </tr>
        <% }) %>
    </tbody>
</table>