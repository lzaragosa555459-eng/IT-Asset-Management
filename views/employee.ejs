<div class="page-header">
    <h1>Employees</h1>
    <button class="btn-add" onclick="window.location.href='/employees/add'">
        + Add New Employee
    </button>
</div>

<div class="table-container">
    <table class="modern-table">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>Name</th>
                <th>Department</th>
                <th>Position</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees && employees.length > 0) { %>
                <% employees.forEach(employee => { %>
                    <tr>
                        <td><%= employee.employee_id %></td>
                        <td><%= employee.name %></td>
                        <td><%= employee.department %></td>
                        <td><%= employee.position %></td>
                        <td><%= employee.email %></td>
                        <td class="action-btns">
                            <button class="btn-edit" onclick="editEmployee(<%= employee.employee_id %>)">Edit</button>
                            <button class="btn-delete" onclick="deleteEmployee(<%= employee.employee_id %>)">Delete</button>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="empty-state">
                        <i>📋</i>
                        No employees found. Click "Add New Employee" to get started.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    // Optional: JavaScript functions for edit/delete
    function editEmployee(id) {
        window.location.href = `/employees/edit/${id}`;
    }
    
    function deleteEmployee(id) {
        if (confirm('Are you sure you want to delete this employee?')) {
            window.location.href = `/employees/delete/${id}`;
        }
    }
</script>