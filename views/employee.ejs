<h1>Employees</h1>

<table border="1">
    <thead>
        <tr>
            <th>Employee Id</th>
            <th>Name</th>
            <th>Department</th>
            <th>Position</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        <% employees.forEach(employee => { %>
            <tr>
                <td><%= employee.employee_id %></td>
                <td><%= employee.name %></td>
                <td><%= employee.department %></td>
                <td><%= employee.position %></td>
                <td><%= employee.email %></td>
            </tr>
        <% }) %>
    </tbody>
</table>